# --- AI provider (README understanding) ---
# Use either OpenAI or Gemini. If neither key is set, the server falls back
# to a rule-based mock analyzer so the demo still works offline.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Algorand / x402 ---
# Network to use: testnet (recommended for hackathon demos) or mainnet
ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud

# The wallet address that RECEIVES payment for deck generation.
# Create a free testnet account at https://bank.testnet.algorand.network/
MERCHANT_WALLET_ADDRESS=

# DEMO ONLY: a 25-word mnemonic for a funded testnet account that pays on the
# user's behalf, so you can demo the full pay -> verify -> unlock loop without
# wiring up a browser wallet (Pera/Defly). NEVER use a mainnet mnemonic here,
# and never commit this file. Fund this account at
# https://bank.testnet.algorand.network/
DEMO_SENDER_MNEMONIC=

# Price per deck generation, in ALGO
DECK_PRICE_ALGO=0.5

PORT=4000
